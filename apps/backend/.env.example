NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=

# Google GenAI API key (required)
GOOGLE_API_KEY=

# Google GenAI endpoint — override only if you need a different model
# GOOGLE_GENAI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-04-17:generateContent

# Optional: Set a secret API key to protect the generate-image endpoint.
# Leave empty to disable API key authentication.
API_KEY=

# RevenueCat server-side API key for REST subscriber lookups
REVENUECAT_API_KEY=

# Shared secret verifying RevenueCat webhook deliveries (Authorization: Bearer {secret})
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat entitlement identifier used to determine active subscription
REVENUECAT_ENTITLEMENT_ID=

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=virtual_try_on
