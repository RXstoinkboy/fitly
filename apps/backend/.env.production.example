# =============================================================================
# Production environment for the VPS deployment (OVHcloud)
# Copy to .env.production and fill in every value.
# The file lives on the VPS only — it is never committed or baked into the
# Docker image (excluded via .dockerignore).
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Generate with: openssl rand -hex 16
APP_KEY=

# Public domain pointed at the VPS (DNS A record). Used by Caddy for
# automatic HTTPS. Required unless you remove the caddy service.
DOMAIN=api.yourdomain.com

# ── Google GenAI ─────────────────────────────────────────────────────────────
# Same key you used on Railway
GOOGLE_API_KEY=

# ── Optional API protection ──────────────────────────────────────────────────
# If set, every app request must send it as `x-api-key`.
# The mobile app must then set the SAME value as EXPO_PUBLIC_API_KEY.
# Leave empty to disable (not recommended once real users are on the API).
API_KEY=

# ── RevenueCat ───────────────────────────────────────────────────────────────
# Same values you used on Railway. Point the RevenueCat webhook in the
# RevenueCat dashboard at https://<DOMAIN>/api/v1/webhooks/revenuecat.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=

# ── PostgreSQL (runs as a container next to the app) ─────────────────────────
# DB_HOST must stay "db" — that is the compose service name.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
# Generate with: openssl rand -base64 32
DB_PASSWORD=
DB_DATABASE=virtual_try_on

# Local Postgres has no TLS. Only set true if you keep a managed DB
# (e.g. Neon) instead of the local container.
DB_SSL=false
